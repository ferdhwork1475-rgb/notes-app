<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= metadata.title %></title>
    <meta name="description" content="<%= metadata.description %>" />
    <link rel="canonical" href="<%= metadata.url %>" />
    <meta property="og:title" content="<%= metadata.title %>" />
    <meta
      property="og:description"
      content="<%= metadata.description.slice(0, 300) %>"
    />
    <meta property="og:image" content="https://res.cloudinary.com/hmz1nkjr/image/upload/v1787245316/ChatGPT_Image_Aug_20_2026_10_43_38_AM.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="<%= metadata.title %>" />
    <meta property="og:url" content="<%= metadata.url %>" />
    <meta property="og:type" content="<%= metadata.type %>" />
    <meta property="og:site_name" content="<%= metadata.siteName %>" />
    <meta property="og:locale" content="en_NG" />
    <script>
      window.location.replace("<%= metadata.url %>");
    </script>
  </head>
  <body></body>
</html>
